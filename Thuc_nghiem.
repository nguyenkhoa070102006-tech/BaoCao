import numpy as np
import matplotlib.pyplot as plt

#RK3
def rk3(f, a, b, y0, n):
    h = (b - a) / n
    x = np.linspace(a, b, n + 1)
    y = np.zeros(n + 1)
    y[0] = y0
    for i in range(n):
        K1 = h * f(x[i], y[i])
        K2 = h * f(x[i] + h/2, y[i] + K1/2)
        K3 = h * f(x[i] + h, y[i] - K1 + 2*K2)
        y[i+1] = y[i] + (K1 + 4*K2 + K3) / 6.0
    return x, y

#RK4
def rk4(f, a, b, y0, n):
    h = (b - a) / n
    x = np.linspace(a, b, n + 1)
    y = np.zeros(n + 1)
    y[0] = y0
    for i in range(n):
        K1 = h * f(x[i], y[i])
        K2 = h * f(x[i] + h/2, y[i] + K1/2)
        K3 = h * f(x[i] + h/2, y[i] + K2/2)
        K4 = h * f(x[i] + h, y[i] + K3)
        y[i+1] = y[i] + (K1 + 2*K2 + 2*K3 + K4) / 6.0
    return x, y

#HAM f VA NGHIEM DUNG
def f(x, y):
    return y - x**2 + 1.0

def exact(x):
    return (x + 1.0)**2 - 0.5 * np.exp(x)

#THUC NGHIEM
def run_experiment():
    a = 0.0
    b = 2.0
    y0 = 0.5
    n_list = [5, 10, 20, 40, 80]
    h_list = [(b - a) / n for n in n_list]

    err_rk3 = []
    err_rk4 = []

    #Bang sai so tai x = b
    print("=" * 55)
    print("BANG SAI SO TAI x = b")
    print("=" * 55)
    print(f"{'n':>4} | {'h':>10} | {'Sai so RK3':>14} | {'Sai so RK4':>14}")
    print("-" * 55)

    for n, h in zip(n_list, h_list):
        _, y3 = rk3(f, a, b, y0, n)
        e3 = abs(y3[-1] - exact(b))
        err_rk3.append(e3)

        _, y4 = rk4(f, a, b, y0, n)
        e4 = abs(y4[-1] - exact(b))
        err_rk4.append(e4)

        print(f"{n:4d} | {h:10.6f} | {e3:14.6e} | {e4:14.6e}")

    #Xac nhan bac 3 và bac 4 bang P4
    print("\n" + "=" * 55)
    print("XAC NHAN BAC HOI TU (P4)")
    print("=" * 55)
    print(f"{'n -> 2n':>12} | {'Bac RK3':>10} | {'Bac RK4':>10}")
    print("-" * 40)
    for i in range(len(n_list) - 1):
        p3 = np.log2(err_rk3[i] / err_rk3[i + 1])
        p4 = np.log2(err_rk4[i] / err_rk4[i + 1])
        print(f"{n_list[i]:4d} -> {n_list[i+1]:4d} | {p3:10.4f} | {p4:10.4f}")

    #Nhan xet
    print("\n" + "=" * 55)
    print("NHAN XET")
    print("=" * 55)
    print("- Sai so cua RK4 nho hon RK3 o moi gia tri n.")
    print("- Khi n tang (h giam), sai so giam theo dung quy luat bac cua phuong phap.")
    print("- Bac hoi tu thuc nghiem cua RK3 xap xi 3, cua RK4 xap xi 4.")
    print("- Do thi log-log cho thay duong RK3 song song voi O(h^3), RK4 song song voi O(h^4).")

    #Do thi
    plt.figure(figsize=(9, 6))
    plt.loglog(h_list, err_rk3, 'o-', linewidth=2, markersize=8, label='RK3')
    plt.loglog(h_list, err_rk4, 's-', linewidth=2, markersize=8, label='RK4')

    h_ref = np.array(h_list)
    plt.loglog(h_ref, err_rk3[0] * (h_ref / h_list[0])**3, '--', alpha=0.7, label='O(h^3)')
    plt.loglog(h_ref, err_rk4[0] * (h_ref / h_list[0])**4, '--', alpha=0.7, label='O(h^4)')

    plt.xlabel('h')
    plt.ylabel('Sai so tai x = b')
    plt.title('Sai so RK3 va RK4 theo h (log-log)')
    plt.grid(True, which='both', ls='--', alpha=0.5)
    plt.legend()
    plt.tight_layout()
    plt.savefig('sai_so_loglog_rk3_rk4.png', dpi=150)
    plt.show()

if __name__ == "__main__":
    run_experiment()
