import math


def rk_table(method, f, a, b, y0, n):
    """Xuat bang tinh tay RK3 hoac RK4 cho y' = f(x, y), y(a) = y0 tren [a, b].

    Require: method 'rk3' hoac 'rk4'; f(x, y); a < b huu han; y0 huu han; n nguyen > 0.
    Ensure: list n+1 dict, dong i (i = 0..n) co cac khoa
        'i', 'x' (= x_i), 'y' (= y_i), 'K1', 'K2', 'K3', ('K4' neu rk4),
        trong do K la he so tinh tu (x_i, y_i) va da nhan voi h (dung quy uoc bang).
        y_{i+1} chinh la 'y' cua dong i+1. Nem ValueError neu dau vao khong hop le.
    Thuat toan: RK3 cong thuc (6.13); RK4 Thuat toan 19, cong thuc (6.14).
    """
    # Kiem tra dieu kien ap dung
    if method not in ("rk3", "rk4"):
        raise ValueError("method phai la 'rk3' hoac 'rk4'")
    if not isinstance(n, int) or n <= 0:
        raise ValueError("n phai la so nguyen duong")
    if not all(math.isfinite(v) for v in (a, b, y0)) or not a < b:
        raise ValueError("Can a < b va a, b, y0 huu han")

    h = (b - a) / n                                   # buoc h
    rows, y = [], float(y0)
    for i in range(n + 1):
        x = a + i * h                                 # x_i
        k1 = h * f(x, y)                              # K1 = h f(x_i, y_i)
        k2 = h * f(x + h / 2, y + k1 / 2)             # K2
        if method == "rk3":
            k3 = h * f(x + h, y - k1 + 2 * k2)        # K3 (6.13)
            ks = {"K1": k1, "K2": k2, "K3": k3}
            y_next = y + (k1 + 4 * k2 + k3) / 6       # y_{i+1} (6.13)
        else:
            k3 = h * f(x + h / 2, y + k2 / 2)         # K3
            k4 = h * f(x + h, y + k3)                 # K4
            ks = {"K1": k1, "K2": k2, "K3": k3, "K4": k4}
            y_next = y + (k1 + 2 * k2 + 2 * k3 + k4) / 6  # y_{i+1} (6.14)
        rows.append({"i": i, "x": x, "y": y, **ks})
        y = y_next                                    # y_{i+1} (dung cho dong sau)
    return rows


def add_exact(rows, y_exact):
    """Them cot 'exact' = y_exact(x) va 'abs_error' = |y - exact| (nhu bang giao trinh)."""
    for r in rows:
        r["exact"] = y_exact(r["x"])
        r["abs_error"] = abs(r["y"] - r["exact"])
    return rows


def format_table(rows, digits=6):
    """In bang dang van ban voi cac cot 'x, approx, K1.., exact, abs_error'."""
    cols = [c for c in ("i", "x", "y", "K1", "K2", "K3", "K4", "exact", "abs_error")
            if c in rows[0]]
    name = {"y": "approx"}
    w = digits + 5

    def cell(c, v):
        return str(v) if c == "i" else (f"{v:.1e}" if c == "abs_error" else f"{v:.{digits}f}")

    lines = ["".join(f"{name.get(c, c):>{w}}" for c in cols)]
    lines += ["".join(f"{cell(c, r[c]):>{w}}" for c in cols) for r in rows]
    return "\n".join(lines)